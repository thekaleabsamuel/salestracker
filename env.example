# Environment Variables for Business Search Dashboard
# Copy this file to .env and add your actual values

# Backend API URL (for frontend to connect to backend server)
# Default: http://localhost:3001/api (for local development)
# For production, set this to your deployed backend URL
VITE_API_URL=http://localhost:3001/api

# Google Places API Configuration (used by backend server)
# Get your API key from: https://console.cloud.google.com/
# Note: This should be set in the server/.env file, not here
# VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Notes: 
# - Vite requires environment variables to be prefixed with VITE_
# - The application will use mock data if backend is not available
# - Backend server needs GOOGLE_PLACES_API_KEY in server/.env

